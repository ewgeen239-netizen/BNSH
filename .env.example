# Public site URL (used for SEO metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://bnsh.space

# Contact channels (shown in UI). Optional — real values are baked into lib/site.ts.
NEXT_PUBLIC_TELEGRAM=https://t.me/ewgeess
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/ewvgeen.s0
NEXT_PUBLIC_EMAIL=ewgeen239@gmail.com

# --- Contact form delivery (server-side) ---
# The /api/contact route always logs the lead. To actually RECEIVE leads,
# configure the Telegram bot below (primary) and/or Resend email (optional).

# Telegram bot — leads arrive as a chat message.
# 1) Create a bot via @BotFather → get the token.
# 2) Send any message to your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email delivery via Resend — https://resend.com
RESEND_API_KEY=
CONTACT_TO=ewgeen239@gmail.com
CONTACT_FROM=BNSH Studio <onboarding@resend.dev>
